    "nosniff",
    "ossf",
    "pengaturan",
    "perkiraan",
    "prformat",
    "produksi",
    "rhysd",
    "sarif",
    "shadcn",
    "shellcheck",
    "sigstore",
    "syafa",
    "tampilkan",
    "terverifikasi",
