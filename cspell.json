{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    ".git/**",
    "CHANGELOG.md",
    "package-lock.json"
  ],
  "files": [
    "**/*.{md,ts,tsx,js,mjs,json,yaml,yml,html,css,sh,conf}",
    "**/Dockerfile"
  ],
  "words": [
    "aethera",
    "akun",
    "alat",
    "anchore",
    "anomali",
    "arus",
    "autorun",
    "baik",
    "batal",
    "batalkan",
    "belum",
    "beranda",
    "beri",
    "blurple",
    "buildx",
    "canva",
    "catat",
    "catatan",
    "chonk",
    "colokan",
    "commitlint",
    "cukup",
    "cyclonedx",
    "daftar",
    "deeptech",
    "dgimsuvy",
    "dijepit",
    "dotenv",
    "dotenvlinter",
    "energi",
    "ganti",
    "geolocation",
    "getsentry",
    "hackathon",
    "hadyan",
    "halaman",
    "hari",
    "healthz",
    "jahit",
    "jenis",
    "juta",
    "kabel",
    "kata",
    "keluar",
    "kembali",
    "koalaman",
    "lainnya",
    "laporan",
    "lemah",
    "lhci",
    "lighthouserc",
    "lupa",
    "lycheeverse",
    "masuk",
    "mati",
    "mencari",
    "mesin",
    "misconfig",
    "nofilter",
    "nonword",
    "nosniff",
    "nyala",
    "oktober",
    "ossf",
    "pabrik",
    "pasang",
    "pengaturan",
    "penjepit",
    "peringatan",
    "periode",
    "perkiraan",
    "persetujuan",
    "pilih",
    "pintar",
    "potong",
    "prformat",
    "produksi",
    "punya",
    "rendah",
    "rhysd",
    "sandi",
    "sarif",
    "sedang",
    "sekitar",
    "shadcn",
    "shellcheck",
    "siaga",
    "sigstore",
    "simpan",
    "sudah",
    "syafa",
    "tambah",
    "tampilkan",
    "terverifikasi",
    "tidak",
    "tinggi",
    "tmpfs",
    "toomanyrequests",
    "toupper",
    "trivyignores",
    "typechecks",
    "umkm",
    "unstub",
    "verifikasi",
    "vite",
    "wagoid",
    "wattlink",
    "wita",
    "wcag",
    "zizmor",
    "zizmorcore",
    "zricethezav"
  ],
  "enableGlobDot": true,
  "dictionaries": [
    "softwareTerms",
    "bash",
    "docker",
    "typescript",
    "node",
    "npm",
    "html",
    "css"
  ],
  "overrides": [
    {
      "filename": [
        "src/**/*.{ts,tsx}",
        "e2e/**/*.ts"
      ],
      "ignoreRegExpList": [
        "/'(?:[^'\\\\\\n]|\\\\.)*'/g",
        "/\"(?:[^\"\\\\\\n]|\\\\.)*\"/g",
        "/`(?:[^`\\\\]|\\\\.)*`/g",
        "/(?:>(?! )|\\})[^<>{}()=;&|\\n]+(?=<|\\{|$)/gm",
        "/^[ \\t]*(?!\\/\\/|\\/\\*|\\*)[A-Za-z][^<>{}=;()\\[\\]`,\\n]* [^<>{}=;()\\[\\]`,\\n]*$/gm",
        "/^[ \\t]*[A-Z][a-z]+[.!?]?$/gm",
    "/^[ \\t]*[a-z]+[.!?]$/gm",
    "/^[ \\t]*(?!\\/\\/|\\/\\*|\\*)[A-Za-z][A-Za-z.,'?!-]*(?: [A-Za-z0-9.,'?!-]+){1,} (?=\\{)/gm",
    "/^[ \\t]*(?!\\/\\/|\\/\\*|\\*)[A-Za-z][A-Za-z.,()'?!-]*(?: [A-Za-z0-9.,()'?!-]+){3,}(?:\\{' '\\})?$/gm",
        "/(?<=[(,=:\\[!&|?{};]\\s*)\\/(?![\\/*])(?:[^\\/\\\\\\n\\[]|\\\\.|\\[(?:[^\\]\\\\\\n]|\\\\.)*\\])+\\/[dgimsuvy]*/g"
      ]
    }
  ]
}
