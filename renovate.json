{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "platformCommit": "enabled",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "assignees": ["SyafaHadyan"],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions"
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitType": "build",
      "addLabels": ["javascript"]
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm-minor-patch"
    },
    {
      "description": "the images of .github/tools/Dockerfile are the tools that CI starts from a workflow, so they take the commit type of the workflows",
      "matchManagers": ["dockerfile"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    },
    {
      "description": "the tools that CI starts from a workflow, such as ls-lint and Renovate itself, take the commit type of the workflows",
      "matchManagers": ["custom.regex"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    }
  ],
  "customManagers": [
    {
      "description": "A version in a workflow that the line above names with a renovate comment, which the bot cannot find in a run step or an action input otherwise",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*(?:version|[A-Z][A-Z0-9_]*_VERSION): [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ]
}
